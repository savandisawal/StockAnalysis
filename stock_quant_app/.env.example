# Claude API key for sentiment scoring
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Basic auth credentials (comma-separated user:password pairs)
AUTH_USERS=admin:changeme,analyst1:changeme

# Database path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///./stock_quant.db

# News API (optional, falls back to RSS)
NEWS_API_KEY=

# Logging level
LOG_LEVEL=INFO

# Model retraining schedule (cron expression)
RETRAIN_CRON=0 16 * * 5
