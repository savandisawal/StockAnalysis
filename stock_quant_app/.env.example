# Deployment environment: dev | prod (prod refuses to start without hashed auth)
ENVIRONMENT=dev

# Claude API key for sentiment scoring
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Basic auth credentials — comma-separated user:bcrypt_hash pairs.
# NEVER plaintext. Generate a hash with:  python -m scripts.hash_password
# Empty AUTH_USERS = all API requests rejected (fail closed).
AUTH_USERS=admin:$2b$12$replace.with.output.of.hash_password.script

# Base directory for mutable state (DBs, logs, saved models).
# Leave unset locally; docker-compose sets DATA_DIR=/data.
# DATA_DIR=/data

# Database URL (derived from DATA_DIR when unset)
# DATABASE_URL=sqlite+aiosqlite:///./stock_quant.db

# News API (optional, falls back to RSS)
NEWS_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# API hardening
# CORS_ORIGINS=https://your-ui.example.com
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_HEAVY=3/minute

# Scheduler
RETRAIN_CRON=0 16 * * 5
TRACKED_STOCKS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK,KOTAKBANK,SBIN,BHARTIARTL,ITC,TATAMOTORS
